PORT=5000
NODE_ENV=development
# Required. MongoDB connection string (persistent database).
# Copy from Atlas → Connect → Connect Your Application, then replace <db_password>:
#   mongodb+srv://vijayaragavan4818_db_user:<db_password>@cluster0.rzx12tu.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority
# Local example:
#   mongodb://localhost:27017/brainarena
MONGO_URI=
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# AI. Options: gemini | openai | mock | none
#   mock  = deterministic demo generator (no API key needed)
#   none  = AI disabled
AI_PROVIDER=mock
# Admin seed (first run creates admin@brainarena.local / Admin12345 if not exists)
ADMIN_EMAIL=admin@brainarena.local
ADMIN_PASSWORD=Admin12345
# Email (for approval/rejection mails) — use Gmail App Password or any SMTP
# If not set, emails are logged to console only (no crash)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=noreply@brainarena.local
GEMINI_API_KEY=
OPENAI_API_KEY=